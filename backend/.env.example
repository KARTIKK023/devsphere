# Server
NODE_ENV=development
PORT=5002

# Database (MongoDB / Atlas)
MONGODB_URI=mongodb://localhost:27017/devsphere

# URLs
# FRONTEND_URL is the SPA origin (CORS + OAuth redirect target)
FRONTEND_URL=http://localhost:5173
# BACKEND_URL is the public base URL of this API (OAuth callback base)
BACKEND_URL=http://localhost:5002

# Auth
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d
# Encrypts provider (GitHub) access tokens at rest. Falls back to JWT_SECRET when unset.
TOKEN_ENCRYPTION_KEY=replace-with-another-random-string-of-at-least-32-characters

# OAuth — optional. Leave blank to hide the corresponding login button.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BACKEND_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=559958269907-094jja3emrt78tq8kpb81lvt287m6its.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# GitHub: https://github.com/settings/developers
#   Authorization callback URL: {BACKEND_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=Ov23likiTJOK65GSE8x1
GITHUB_CLIENT_SECRET=86178aa7b0c6c3996aa1350af652061224f332fa

# Platform admin bootstrap (used by `npm run create:platform-admin`)
PLATFORM_ADMIN_NAME=DevSphere Admin
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-please
